@inherits LayoutComponentBase
@using PKHeX.Web.Services.Plugins
@using PKHeX.Web.Services
@implements IDisposable
@inject NavigationManager Navigation
@inject GameService GameService
@inject EditorConfigService EditorConfig

<PageTitle>@EditorConfig.Current.SiteName</PageTitle>

<div class="app-shell">
    <style>
        :root {
            --editor-bg: @EditorConfig.Current.BackgroundColor;
            --editor-surface: @EditorConfig.Current.SurfaceColor;
            --editor-text: @EditorConfig.Current.TextColor;
            --editor-muted: @EditorConfig.Current.MutedColor;
            --editor-border: @EditorConfig.Current.BorderColor;
            --editor-accent: @EditorConfig.Current.PrimaryColor;
            --editor-accent-dark: @EditorConfig.Current.PrimaryHoverColor;
            --editor-button: @EditorConfig.Current.ButtonColor;
            --editor-button-hover: @EditorConfig.Current.ButtonHoverColor;
        }
    </style>
    <header class="topbar">
        <a class="brand" href="./">
            @if (!string.IsNullOrWhiteSpace(EditorConfig.Current.LogoUrl))
            {
                <img class="brand-logo" src="@ResolveAsset(EditorConfig.Current.LogoUrl)" alt="" />
            }
            else
            {
                <span class="brand-symbol">✦</span>
            }
            <span>@EditorConfig.Current.HeaderText</span>
        </a>

        <nav class="topnav" aria-label="Editor navigation">
            <a href="./">Overview</a>
            <a href="party">Party</a>
            <a href="pokemon-box">Boxes</a>
            <a href="items">Items</a>
            @if (EditorConfig.Current.ShowPlugins) { <a href="plugins">Plugins</a> }
            @if (EditorConfig.Current.ShowAnalytics) { <a href="analytics">Analytics</a> }
            @if (EditorConfig.Current.ShowSave) { <a class="save-nav" href="save">Save</a> }
            @if (EditorConfig.Current.ShowOpen) { <a href="load">Open</a> }
        </nav>

        <div class="topbar-spacer"></div>
        @if (EditorConfig.Current.ShowSource)
        {
            <a class="github-link" href="https://github.com/arleypadua/PKHeX.Everywhere" target="_blank" rel="noopener">Source</a>
        }
    </header>

    @if (GameService.IsLoaded)
    {
        <div class="game-status-bar"><span class="status-dot"></span><span>Save loaded</span></div>
    }

    <main class="app-content">
        @Body
    </main>

    <footer class="app-footer">
        <span>@EditorConfig.Current.SiteName</span>
        <span>@EditorConfig.Current.FooterText</span>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await EditorConfig.LoadAsync();
        StateHasChanged();
    }

    private string ResolveAsset(string path)
        => string.IsNullOrWhiteSpace(path) ? string.Empty : new Uri(new Uri(Navigation.BaseUri), path.TrimStart('/')).ToString();

    public void Dispose() { }
}
